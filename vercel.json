{
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/openai/(.*)",
      "destination": "https://api.openai.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
