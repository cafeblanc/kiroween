# =================================================================
# PROMETHEUS-iPSC (Kiroween 2026) - server environment
# Copy to .env.local for `vercel dev`, or set these in Vercel project settings.
# Keys stay on the server (api/*.ts) and are never sent to the browser.
# =================================================================

# LTX video API (https://console.ltx.video). Used by /api/generate-video for
# monster growth clips and arena battles (ltx-2-5-fast, 1080p).
# LTX_API_KEY is accepted as an alias.
LTXV_API_KEY=your_ltx_api_key_here

# HuggingFace access token (https://huggingface.co/settings/tokens).
# Used by /api/generate-image (stable-diffusion-3-medium) for free monster
# design images. Without it the app falls back to Pollinations, then to
# the bundled sample image.
HF_TOKEN=your_huggingface_token_here
